// Config.xcconfig.example — copy to `Config.xcconfig` and fill in your own values.
// Config.xcconfig is git-ignored; never commit real keys.

// Soniox real-time STT API key — https://soniox.com
SONIOX_API_KEY = YOUR_SONIOX_API_KEY

// OpenRouter API key for AI summaries (no backend server). OpenRouter fronts several
// upstream providers for the pinned model, so an overloaded one is routed around.
// Create one at https://openrouter.ai/keys — bring your own key.
OPENROUTER_API_KEY = YOUR_OPENROUTER_API_KEY

// Support inbox surfaced in Settings → Support (mailto: subjects distinguish the action).
SUPPORT_EMAIL = support@YOUR-DOMAIN

// Google Sign-In OAuth callback = REVERSED_CLIENT_ID from GoogleService-Info.plist
REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_REVERSED_CLIENT_ID
