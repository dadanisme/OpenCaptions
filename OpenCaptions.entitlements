<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- REQUIRED under App Sandbox for Keychain Services (SecItemAdd/SecItemCopyMatching)
	     to work at all for the app's own items — without a keychain-access group, calls
	     fail with errSecMissingEntitlement (-34018). $(AppIdentifierPrefix) resolves to
	     the signing team's prefix. Backs the runtime-entered Soniox/OpenRouter API keys
	     (Settings -> API Keys, APIKeyStore). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.muhammadramdan.OpenCaptions</string>
	</array>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Network access covers the Soniox and OpenRouter sockets/requests. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Lets the sandboxed app write the exported PDF to a user-chosen location
	     via NSSavePanel (Powerbox). Without it the save panel refuses to open. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Markdown export writes to a folder the user picks ONCE and the app reuses on
	     every later save. The user-selected grant above only lasts as long as the
	     Powerbox session, so the folder is persisted as an app-scoped
	     security-scoped bookmark (MarkdownExportLocation) — which needs this.
	     See docs/2026-07-31-macos-markdown-export.md. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
