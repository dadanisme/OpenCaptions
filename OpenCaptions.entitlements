<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Sign in with Apple. The Apple button is currently hidden in SignInView
	     (Firebase rejects its token audience for the committed custom bundle id);
	     the capability is kept so it can be re-enabled. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- REQUIRED for Firebase Auth under App Sandbox: without a keychain-access
	     group, FirebaseAuth's keychain persistence fails with
	     errSecMissingEntitlement (-34018) and sign-in state won't survive relaunch.
	     $(AppIdentifierPrefix) resolves to the signing team's prefix. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.muhammadramdan.OpenCaptions</string>
	</array>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Network access covers the Soniox/summary sockets and Google Sign-In's
	     ASWebAuthenticationSession. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Lets the sandboxed app write the exported PDF to a user-chosen location
	     via NSSavePanel (Powerbox). Without it the save panel refuses to open. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Markdown export writes to a folder the user picks ONCE and the app reuses on
	     every later save. The user-selected grant above only lasts as long as the
	     Powerbox session, so the folder is persisted as an app-scoped
	     security-scoped bookmark (MarkdownExportLocation) — which needs this.
	     See docs/2026-07-31-macos-markdown-export.md. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
