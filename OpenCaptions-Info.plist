<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- User-facing app name. Pins CFBundleName to "Open Captions" so the macOS menu bar, the
	     About/Hide/Quit items, and the window title read "Open Captions". The built artifact is OpenCaptions.app
	     (PRODUCT_NAME = OpenCaptions in the target's build settings).
	     Dock/Finder use CFBundleDisplayName, set via INFOPLIST_KEY_CFBundleDisplayName. -->
	<key>CFBundleName</key>
	<string>Open Captions</string>
	<!-- Export-compliance declaration. Open Captions only uses standard TLS/HTTPS (Soniox WSS,
	     Firebase, Google Sign-In) — no proprietary/non-exempt encryption — so this is
	     false, which suppresses the per-upload encryption question in App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- TCC usage string for Core Audio process-tap system-audio capture (the
	     "Audio Recording" grant, kTCCServiceAudioCapture). Required for the
	     system-audio permission prompt to appear on the first capture start. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Open Captions records other apps' audio so it can transcribe your session.</string>
	<key>SONIOX_API_KEY</key>
	<string>$(SONIOX_API_KEY)</string>
	<!-- Google Gemini API key for native (backend-less) AI summaries — read at
	     runtime via Bundle.main.infoDictionary in SummaryService+Gemini. Supplied
	     per-deployment via the git-ignored Config.xcconfig (bring-your-own key). -->
	<key>GEMINI_API_KEY</key>
	<string>$(GEMINI_API_KEY)</string>
	<!-- Support inbox surfaced in Settings → Support. Supplied per-deployment via the
	     git-ignored Config.xcconfig. -->
	<key>SUPPORT_EMAIL</key>
	<string>$(SUPPORT_EMAIL)</string>
	<!-- Google Sign-In OAuth callback. The value is the Firebase app's
	     REVERSED_CLIENT_ID; kept generic here and supplied per-developer via the
	     git-ignored Config.xcconfig (REVERSED_CLIENT_ID = com.googleusercontent.apps.…). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
